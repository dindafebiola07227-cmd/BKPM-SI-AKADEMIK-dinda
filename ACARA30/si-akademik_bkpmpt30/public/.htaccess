RewriteEngine On

# Acara 30 (Langkah 2): paksa seluruh trafik ke HTTPS pada server produksi.
# localhost dikecualikan agar XAMPP tanpa SSL tetap dapat dipakai saat pengembangan.
# Di belakang proxy/CDN (mis. Cloudflare) HTTPS dideteksi lewat header X-Forwarded-Proto.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Izinkan file frontend dan resource dimuat browser.
Options -Indexes
Require all granted
DirectoryIndex views/login.html index.php

# Teruskan header Authorization ke PHP.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Hanya request API/non-file yang diteruskan ke front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
