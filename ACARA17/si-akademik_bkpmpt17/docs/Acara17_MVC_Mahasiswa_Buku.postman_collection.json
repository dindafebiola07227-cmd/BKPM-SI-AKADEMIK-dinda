    {
      "name": "1. Resource Mahasiswa (CRUD + validasi)",
      "item": [
        {
          "name": "1. POST - Tambah mahasiswa",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// NIM acak supaya collection bisa dijalankan berulang kali",
                  "pm.collectionVariables.set('nimBaru', '22' + String(Date.now()).slice(-7));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response berformat JSON', () => pm.response.to.be.json);",
                  "const j = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(j.success).to.eql(true));",
                  "pm.test('data.id berupa angka', () => pm.expect(j.data.id).to.be.a('number'));",
                  "pm.collectionVariables.set('mhsId', j.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mahasiswa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mahasiswa"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nim\": \"{{nimBaru}}\",\n  \"nama\": \"Andi Saputra\",\n  \"prodi\": \"Teknik Informatika\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
