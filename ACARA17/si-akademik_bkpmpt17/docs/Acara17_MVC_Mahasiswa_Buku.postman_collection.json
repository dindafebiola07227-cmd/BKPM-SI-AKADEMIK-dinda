                  "const j = pm.response.json();",
                  "pm.test('success = true', () => pm.expect(j.success).to.eql(true));",
                  "pm.test('data berupa array', () => pm.expect(j.data).to.be.an('array'));",
                  "pm.test('data baru ikut tampil', () => pm.expect(j.data.map(d => Number(d.id))).to.include(Number(pm.collectionVariables.get('mhsId'))));"
